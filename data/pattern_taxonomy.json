    {
      "match": "(^|-)bfs($|-)|breadth-first",
      "family": "bfs"
    },
    {
      "match": "(^|-)dfs($|-)|depth-first",
      "family": "dfs"
    },
    {
      "match": "binary-search",
      "family": "binary-search"
    },
    {
      "match": "(^|-)(segment-tree|fenwick-tree)($|-)",
      "family": "segment-tree"
    },
    {
      "match": "two-pointer",
      "family": "two-pointers"
    },
    {
      "match": "stars-and-bars|binomial|permutation-counting|combination-counting|catalan|pigeonhole|inclusion-exclusion|counting-ways",
      "family": "combinatorics"
    },
    {
      "match": "(^|-)(gcd|lcm)($|-)|divisor|(^|-)primes?($|-)|prime-|sieve|modular|modulo|totient|coprime|factorization|euclid",
      "family": "number-theory"
    },
    {
      "match": "disjoint-set|(^|-)dsu($|-)(?!on-tree)",
      "family": "union-find",
      "note": "excludes dsu-on-tree, which is small-to-large merging, not disjoint-set union"
    }
  ],
